# GitHub PAT (or App installation token) with Contents+Metadata read on every
# private remote listed in sync.config.ts. Local: this env name in `.env`.
# Required for `bun run sync` and remotes in `bun run sync:dev:all`.
# Not required for fixtures-only `bun run sync:dev`.
# Profile remote is optional (omit/TODO in sync.config → skip profile on prod sync).
#
# CI (GitHub Actions): Actions reserves secrets.GITHUB_TOKEN for the installation
# token, which cannot read arbitrary private remotes. Store the same PAT as a
# repository secret named PORTFOLIO_GITHUB_TOKEN; deploy.yml maps it to
# process.env.GITHUB_TOKEN for `bun run sync` (prod only). PR CI uses `sync:dev`.
GITHUB_TOKEN=

# Site URL + base path (Astro `site` / `base`). Local defaults are fine for `bun run dev`.
# GitHub Pages project site: set repository Actions variables ASTRO_SITE and
# ASTRO_BASE (e.g. https://username.github.io and /repo-name). Both CI and
# deploy workflows read vars.ASTRO_SITE / vars.ASTRO_BASE.
ASTRO_SITE=http://localhost:4321
ASTRO_BASE=/

LEARNING_SIGNALS_ENABLED=true