---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/project/ProjectCard.astro";
import { Icon } from "astro-icon/components";
import Button from "@/components/starwind/button";
import { getHomepageProjects, getPersonal } from "@/lib/portfolio/query";

const homepageProjects = await getHomepageProjects();
const personal = await getPersonal();

const areas = [
  {
    iconName: "lucide:server",
    title: "DevOps",
    color: "text-purple-400",
    description: "CI/CD, infrastructure as code and cloud orchestration",
  },
  {
    iconName: "lucide:code",
    title: "WebApp",
    color: "text-blue-400",
    description: "High-performance APIs, microservices & distributed systems",
  },
  {
    iconName: "lucide:brain",
    title: "ML / MLOps",
    color: "text-orange-400",
    description: "MLOps, model deployment and data pipelines",
  },
];
---

<Layout title="Home" description={personal?.data.heroSection}>
  <div class="pt-32 pb-32 animate-fade-up">
    <section class="px-6 max-w-7xl mx-auto mt-24 mb-12">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-end mt-12 pb-12"
      >
        <div class="lg:col-span-2"></div>
        <div class="lg:col-span-8 space-y-12">
          <div>
            <div class="flex justify-center gap-4 mb-4">
              <span class="section-label">Available for projects</span>
              <div
                class="w-1.5 h-1.5 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.4)]"
              >
              </div>
            </div>
            <h1 class="hero-name text-center">
              {personal?.data.heroAdditionalText || personal?.data.heroSection}
            </h1>
          </div>
          <div class="flex justify-center gap-4">
            <p class="text-xl font-light leading-relaxed italic opacity-60">
              "{personal?.data.heroSection}"
            </p>
          </div>
        </div>
      </div>
      <div class="flex justify-center gap-4">
        <Button size="sm" href="/projects"
          >View My Work <Icon name="lucide:external-link" />
        </Button>
        <Button size="sm" href="/about" variant="outline">About Me</Button>
      </div>

      <div class="mx-auto mt-20 grid max-w-4xl gap-4 sm:grid-cols-3">
        {
          areas.map((area) => (
            <div
              class="
        group 
		rounded-xl 
        border border-slate 
        bg-[#080808] 
        p-6 
        backdrop-blur-sm 
        transition-all 
        hover:bg-accent/10 
        hover:border-accent
		max-w-md
      "
            >
              <div class="mb-4 inline-flex rounded-lg dark:bg-neutral-900 p-2 text-muted-foreground">
                <Icon
                  name={area.iconName}
                  class={`h-5 w-5 ${area.color} dark:text-slate-300`}
                />
              </div>
              <h3 class="font-semibold text-foreground text-base">
                {area.title}
              </h3>
              <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                {area.description}
              </p>
            </div>
          ))
        }
      </div>
    </section>
</div>
<div class="pt-24 bg-[#070707] border-t">
  <section class="space-y-12 max-w-7xl mx-auto w-full px-6">
	<div>
	  <h1 class="text-4xl font-serif italic">Recent Projects</h1>
	  <p class="mb-12 text-sm text-muted-foreground leading-relaxed">
		The three most recently released projects across all categories.
	  </p>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
	  {homepageProjects.map((project) => (
	    <ProjectCard project={project} />
	  ))}
	</div>
  </section>
</div>

<section class="border-t border-border/50 ">
	<div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
	<div
		class="rounded-2xl border border-border/50 bg-gradient-to-br from-card via-card to-muted/50 p-8 text-center sm:p-12 lg:p-16"
	>
		<h2
		class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl"
		>
		Interested in working together?
		</h2>
		<p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
		I&apos;m always open to discussing new projects, creative ideas, or
		opportunities to be part of your visions.
		</p>
		<div class="mt-8">
			<Button 
			href="/about"
			size="md" class="gap-2">
			Get In Touch
			<Icon name="lucide:arrow-right" class="h-4 w-4" />
			</Button>
		
		</div>
	</div>
	</div>
</section>
</Layout>
