---
import Layout from "@/layouts/Layout.astro";
import ProjectGrid from "@/components/project/ProjectGrid.astro";
import { queryProjects } from "@/lib/portfolio/query";

const projects = await queryProjects();
---

<Layout title="Projects">
	<div class="page-container space-y-16 animate-fade-up">
		<div class="space-y-4">
			<h1 class="text-6xl font-serif italic">My Projects.</h1>
			<p class="text-[14px] tracking-[0.1em] opacity-40 max-w-2xl">A collection of my work in DevOps, web applications, and machine learning. Each project represents a unique challenge and learning experience.</p> 
		</div>
	</div>
	
	<div class="page-container animate-fade-up">
		<ProjectGrid projects={projects} />
	</div>
</Layout>
