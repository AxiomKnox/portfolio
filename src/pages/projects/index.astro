---
import Layout from "@/layouts/Layout.astro";
import ProjectsPageIsland from "@/components/islands/ProjectsPageIsland";
import { getProfile, getProjects } from "@/content/adapter";
import { optimizeProjectPreviewMap } from "@/lib/content-images";
import { readSearchState } from "@/lib/project-discovery";

const profile = await getProfile();
const projects = await getProjects();
const previewImages = await optimizeProjectPreviewMap(projects, { width: 640, height: 360 });
const initialSearch = readSearchState(Astro.url.searchParams);
---

<Layout
  title={`Projects — ${profile.fullName}`}
  description="A worked-through selection of DevOps, web, and ML projects with source, live links, and architecture notes."
>
  {/* Pre-paint: static builds SSR the unfiltered list. Hide results when the URL
      already has filters (or stored list view) so hydration can apply state without CLS. */}
  <style is:inline slot="head">
    html[data-projects-await-filters] [data-projects-results] > * {
      display: none !important;
    }
  </style>
  <script is:inline slot="head">
    (function () {
      try {
        var p = new URLSearchParams(location.search);
        var keys = ["q", "cat", "statuses", "techs", "gh", "live", "from", "to"];
        for (var i = 0; i < keys.length; i++) {
          if (p.has(keys[i])) {
            document.documentElement.setAttribute("data-projects-await-filters", "");
            return;
          }
        }
        if (localStorage.getItem("projects:view") === "list") {
          document.documentElement.setAttribute("data-projects-await-filters", "");
        }
      } catch (e) {}
    })();
  </script>

  <section class="mx-auto max-w-6xl px-6 pt-16">
    <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">/projects</div>
    <h1 class="mt-3 text-3xl font-medium tracking-tight sm:text-4xl">
      Everything I've shipped worth linking to.
    </h1>
    <p class="mt-3 max-w-2xl text-sm text-muted-foreground">
      Filter by category, tech, or status. Search supports{" "}
      <code class="font-mono text-xs">tech:"React"</code> and{" "}
      <code class="font-mono text-xs">year:2024</code>.
    </p>
  </section>

  <ProjectsPageIsland
    client:idle
    projects={projects}
    previewImages={previewImages}
    initialSearch={initialSearch}
  />
</Layout>
