---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/starwind/badge";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import { Separator } from "@/components/starwind/separator";
import TechIcon from "@/components/project/TechIcon.astro";
import ArchitectureSection from "@/components/project/ArchitectureSection";
import {
  cn,
  getCategoryClass,
  getCategoryLabel,
  getStatusLabel,
} from "@/lib/utils";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import placeholderImage from "@/assets/projects/placeholder.svg";
import { Icon } from "astro-icon/components";
import { getStatusColor } from "@/lib/utils";
import Button from "@/components/starwind/button";
import Prose from "@/components/starwind/prose";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const allProjects = await getCollection("projects");

const dateOptions = {
  year: "numeric",
  month: "long",
  day: "numeric",
} as const;

const related = allProjects.filter((p) =>
  project.data.relatedProjects.includes(p.data.id),
);

const architectureModules = import.meta.glob<{
  default: import("@/components/project/ArchitectureDiagram").ArchitectureData;
}>("@/data/architecture/*.json");

const architectureKey = `@/data/architecture/${project.data.slug}.json`;
const architectureLoader = architectureModules[architectureKey];
const architectureData = architectureLoader
  ? (await architectureLoader()).default
  : null;
---

<Layout title={project.data.name} description={project.data.summary}>
  <div class="page-container max-w-6xl space-y-16 animate-fade-up">
    <a
      href={`${import.meta.env.BASE_URL}projects`}
      class="inline-flex items-center gap-2 text-[10px] uppercase tracking-widest opacity-40 hover:opacity-100 transition-colors"
    >
      ← Back to Archive
    </a>

    <section class="space-y-8">
      <!-- <div class="aspect-[21/9] rounded-xl overflow-hidden border border-white/10">
				<Image
					src={placeholderImage}
					alt={`${project.data.name} preview`}
					class="w-full h-full object-cover"
					width={1200}
					height={514}
					loading="eager"
				/>
			</div> -->

      <div class="space-y-4">
        <div class="flex flex-wrap items-center gap-4">
          <span class="text-xs font-mono tracking-tighter opacity-30 uppercase"
            >{project.data.id}</span
          >
          <!-- <Separator orientation="vertical" class="h-4" /> -->
          <Badge
            variant="outline"
			size="sm"
            class={getCategoryClass(project.data.category)}
          >
            {getCategoryLabel(project.data.category).toUpperCase()}
          </Badge>
        </div>
        <h1 class="text-5xl sm:text-6xl font-serif leading-tight">
          {project.data.name}
        </h1>
        <p
          class="text-md font-light italic opacity-60 max-w-2xl leading-relaxed"
        >
          {project.data.summary}
        </p>
      </div>

      <div class="flex flex-wrap gap-4">
        {
          project.data.repoUrl && (
            // <a
            //   href={project.data.repoUrl}
            //   target="_blank"
            //   rel="noopener"
            //   class="inline-flex items-center gap-2 px-6 py-3 bg-white text-black text-[10px] font-bold uppercase tracking-widest hover:bg-white/90 transition-colors"
            // >
			// 	<Icon name="simple-icons:github" class="w-4 h-4" />
			// 	Repository
            // </a>
			<Button href={project.data.repoUrl} target={"_blank"} rel={"noopener"}>
				<Icon name="simple-icons:github" class="w-4 h-4" />
				Repository
			</Button>
          )
        }
        {
			project.data.liveUrl && (
			// 	<a
			// 	href={project.data.liveUrl}
			// 	target="_blank"
			// 	rel="noopener"
			// 	class="inline-flex items-center gap-2 px-6 py-3 border border-white/20 text-[10px] font-bold uppercase tracking-widest hover:bg-white/5 transition-colors"
			// 	>
			// 	<Icon name="lucide:external-link" class="w-4 h-4" />
            //   Live Site
            // </a>
			<Button 
			href={project.data.liveUrl}
			variant="ghost"
			target={"_blank"} rel={"noopener"}>
				<Icon name="lucide:external-link" class="w-4 h-4" />
				Live Site
			</Button>
          )
        }
      </div>
      <Separator />
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-8 space-y-12">
        <div class="space-y-6">
          <h2 class="text-xl tracking-widest">Description</h2>
          <Prose >
			  <Content />
		  </Prose >
        </div>
      </div>
      <aside class="lg:col-span-4 space-y-6">
        <Card class={"max-w-sm dark:bg-zinc-950 backdrop-blur-md"}>
          <CardHeader>
            <CardTitle class="text-xl tracking-widest">Properties</CardTitle>
          </CardHeader>
          <CardContent class="space-y-3 text-sm">
            <div>
              <span class="text-sm font-medium text-muted-foreground">
                Status
              </span>
              <div class="pt-2 pb-4">
                <Badge class={getStatusColor(project.data.status as string)}>
                  <Icon name={"lucide:circle-dot"} class="w-4 h-4 mt-0.25" />
                  {project.data.status}
                </Badge>
              </div>
              <div class="justify-between gap-4">
                <span class="opacity-40">Type</span>
                <br />
                <span class="flex gap-2 pt-2 pb-4">
                  <Icon name={"ph:info"} class="w-4 h-4 mt-0.25" />
                  {project.data.type}
                </span>
              </div>
            </div>
            <div class="justify-between gap-4">
              <span class="opacity-40">Version</span>
              <br />
              <span class="flex gap-2 pt-2 pb-4">
                <Icon name={"ph:git-branch"} class="w-4 h-4 mt-0.25" />
                v{project.data.version}
              </span>
            </div>
            {
              project.data.releaseDate && (
                <div class="justify-between gap-4">
                  <span class="opacity-40">Released</span>
                  <br />
                  <span class="flex gap-2 pt-2 pb-4">
                    <Icon name={"ph:calendar-blank"} class="w-4 h-4 mt-0.25" />
                    {project.data.releaseDate.toLocaleDateString(
                      "en-IN",
                      dateOptions,
                    )}
                  </span>
                </div>
              )
            }
            <div>
              <span class="opacity-40 block mb-2">Tech Stack</span>
              <div class="flex flex-wrap gap-2">
                {
                  project.data.techStack.map((tech) => (
                    <Badge
                      size="sm"
                      variant="outline"
                      class="flex items-center gap-1.5"
                    >
                      <TechIcon tech={tech} class="w-3 h-3" />
                      {tech}
                    </Badge>
                  ))
                }
              </div>
            </div>
          </CardContent>
        </Card>

        {
          related.length === 0 && (
            <Card class={"max-w-sm dark:bg-zinc-950 backdrop-blur-md"}>
              <CardHeader>
                <CardTitle class="text-md tracking-widest">
                  Related Projects
                </CardTitle>
              </CardHeader>
              <CardContent class="space-y-3">
                {related.map((rel) => (
                  <a
                    href={`${import.meta.env.BASE_URL}projects/${rel.data.slug}`}
                    class="block hover:opacity-100 opacity-70 transition-opacity"
                  >
                    <span
                      class={cn(
                        "text-[10px] uppercase",
                        getCategoryClass(rel.data.category),
                      )}
                    >
                      {getCategoryLabel(rel.data.category)}
                    </span>
                    <p class="font-serif">{rel.data.name}</p>
                  </a>
                ))}
              </CardContent>
            </Card>
          )
        }
      </aside>
    </section>
    <section>
      {
        project.data.architectureDescription && (
          <div class="space-y-6">
            <h2 class="section-label">System Architecture</h2>
            <p class="text-sm font-light opacity-60 italic">
              {project.data.architectureDescription}
            </p>
            {architectureData ? (
              <ArchitectureSection client:visible data={architectureData} />
            ) : (
              <div class="aspect-video border border-white/10 flex items-center justify-center font-mono text-[10px] uppercase tracking-[0.5em] opacity-20 bg-black/20 rounded-lg">
                Architecture diagram coming soon
              </div>
            )}
          </div>
        )
      }
    </section>
  </div>
</Layout>
