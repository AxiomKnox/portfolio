---
import { cn, getCategoryClass, getCategoryLabel } from "@/lib/utils";
import TechIcon from "@/components/project/TechIcon.astro";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import placeholderImage from "@/assets/projects/placeholder.svg";
import { Icon } from "astro-icon/components";

type Project = CollectionEntry<"projects">;

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className } = Astro.props;
const { slug, name, category, summary, techStack } = project.data;
const href = `${import.meta.env.BASE_URL}projects/${slug}`;
---

<article
  class={cn("relative overflow-hidden group h-full", className)}
  data-category={category}
>
  <a href={href} class="block h-full">
    <div
      class="p-6 md:p-8 h-full flex flex-col justify-between transition-colors"
    >
      <div
        class="aspect-video rounded-lg mb-6 flex items-center justify-center transition-all duration-500 overflow-hidden relative"
        style="background-color: var(--card-bg)"
      >
        <div
          class="absolute inset-0 transition-colors duration-300 group-hover:bg-black/10 light:group-hover:bg-white/10"
        >
        </div>
        <Image
          src={placeholderImage}
          alt={`${name} preview`}
          class="relative z-10 w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
          width={400}
          height={225}
          loading="lazy"
        />
      </div>

      <div class="flex justify-between items-start mb-2">
        <p
          class={cn(
            "text-[10px] uppercase tracking-widest font-semibold",
            getCategoryClass(category),
          )}
        >
          {getCategoryLabel(category)}
        </p>
		<Icon 
		  name={"lucide:arrow-up"} 
		  class="w-4 h-4 opacity-20 rotate-45 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300"
		/>

	</div>
	
	<div class="space-y-3 flex-1">
		<h3
		class="text-2xl font-serif group-hover:opacity-100 transition-colors"
        >
		{name}
	</h3>
        <p class="text-sm font-light leading-relaxed opacity-60 line-clamp-2">
          {summary}
        </p>
      </div>

      <div class="mt-6 flex flex-wrap gap-2 items-center">
        {
          techStack.slice(0, 3).map((tech) => (
            <span class="px-2 py-1 flex items-center gap-1.5" title={tech}>
              <TechIcon tech={tech} />
            </span>
          ))
        }
        {
          techStack.length > 3 && (
            <span class="text-[9px] uppercase tracking-widest opacity-40">
              +{techStack.length - 3}
            </span>
          )
        }
      </div>
    </div>
  </a>
  <div
    class="absolute bottom-0 left-0 h-px w-0 bg-white/40 group-hover:w-full transition-all duration-500 ease-in-out"
  >
  </div>
</article>
