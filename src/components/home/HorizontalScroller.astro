---
import ProjectCard from "@/components/project/ProjectCard.astro";
import type { CollectionEntry } from "astro:content";

type Project = CollectionEntry<"projects">;

interface Props {
	title: string;
	projects: Project[];
}

const { title, projects } = Astro.props;
---

{
	projects.length > 0 && (
		<section class="space-y-8">
			<div class="flex items-center justify-between px-6">
				<h2 class="section-label">{title}</h2>
				<div class="h-px bg-white/10 flex-1 ml-8" />
			</div>
			<div class="relative overflow-hidden">
				<div class="flex gap-6 overflow-x-auto pb-8 snap-x snap-mandatory px-6 no-scrollbar">
					{projects.map((project) => (
						<div class="snap-start shrink-0 w-[320px] sm:w-[400px]">
							<ProjectCard project={project} />
						</div>
					))}
					<div class="shrink-0 w-6" />
				</div>
			</div>
		</section>
	)
}
