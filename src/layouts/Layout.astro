---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import { getPersonal } from "@/lib/portfolio/query";
import "@/styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const { title = "Portfolio", description = "Personal portfolio" } = Astro.props;
const personal = await getPersonal();
const siteName = personal
	? `${personal.data.longInitials}`
	: "Portfolio";
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<title>{title === "Portfolio" ? siteName : `${title} · ${siteName}`}</title>
		<ClientRouter />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-playfair" preload />
	</head>
	<body>
		<div class="mesh-bg" aria-hidden="true">
			<div class="mesh-blob blob-1"></div>
			<div class="mesh-blob blob-2"></div>
			<div class="mesh-blob blob-3"></div>
		</div>
		<Navbar personal={personal?.data} />
		<slot />
		<Footer personal={personal?.data} />
	</body>
</html>

<style is:global>
	:root {
		--font-sans: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
		--font-serif: var(--font-playfair), ui-serif, Georgia, serif;
	}
</style>
